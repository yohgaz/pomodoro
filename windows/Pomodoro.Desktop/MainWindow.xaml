<Window x:Class="Pomodoro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pomodoro" Width="1400" Height="900" MinWidth="720" MinHeight="480"
        Background="{StaticResource Bg}" Icon="pomodoro.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0B0D14"/>
        <Grid x:Name="Splash" Background="{StaticResource Bg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pomodoro.ico" Width="72" Height="72" Margin="0,0,0,18"/>
                <TextBlock x:Name="SplashText" Text="Démarrage de Pomodoro…" Foreground="{StaticResource Tx}"
                           FontFamily="{StaticResource Font}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashHint" Foreground="{StaticResource Mu}" FontFamily="{StaticResource Font}" FontSize="13"
                           Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
                <Button x:Name="RetryBtn" Content="Réessayer" Visibility="Collapsed" Margin="0,18,0,0" Padding="18,8"
                        HorizontalAlignment="Center" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        FontFamily="{StaticResource Font}" FontWeight="Bold" Cursor="Hand" Click="Retry_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
