<Window x:Class="Pomodoro.Desktop.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture rapide — Pomodoro" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="{StaticResource Font}">
    <Window.Resources>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Mu}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="9" Padding="12,6" Background="Transparent" BorderThickness="1" BorderBrush="#22FFFFFF">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#26F0653D"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#F0653D"/>
                                <Setter Property="Foreground" Value="{StaticResource Tx}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Tx}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="18" CornerRadius="18" Background="{StaticResource C1}" BorderBrush="#33F0653D" BorderThickness="1" Padding="18,16,18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Image Source="pomodoro.ico" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Capture rapide" Foreground="{StaticResource Tx}" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="ModeNote" Style="{StaticResource Pill}" Content="📥 Note (Inbox)" IsChecked="True" GroupName="mode"/>
                    <RadioButton x:Name="ModePerso" Style="{StaticResource Pill}" Content="🏠 Tâche perso" GroupName="mode"/>
                    <RadioButton x:Name="ModeStream" Style="{StaticResource Pill}" Content="🎥 Tâche stream" GroupName="mode" Margin="0"/>
                </StackPanel>
            </DockPanel>
            <Border CornerRadius="11" Background="{StaticResource C2}" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,10">
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Tx}" CaretBrush="#F0653D"
                         FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
            <DockPanel Margin="2,10,2,0">
                <TextBlock x:Name="Status" Foreground="{StaticResource Mint}" FontSize="12.5" FontWeight="Bold" DockPanel.Dock="Right"/>
                <TextBlock Foreground="{StaticResource Mu}" FontSize="12.5" FontWeight="SemiBold"
                           Text="Entrée : enregistrer · Tab : changer de type · Échap : fermer"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
