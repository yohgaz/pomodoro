<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pomodoro</AssemblyName>
    <RootNamespace>Pomodoro.Desktop</RootNamespace>
    <ApplicationIcon>pomodoro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Pomodoro</Product>
    <Description>Pomodoro — notes IPARA et liste de tâches du stream</Description>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <NoWarn>WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="pomodoro.ico" />
  </ItemGroup>

</Project>
